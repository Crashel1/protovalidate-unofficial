from typing import List
from google.protobuf.message import Message
from buf.validate import validate_pb2

class CompilationError(Exception): ...
class EvaluationError(RuntimeError): ...
class Violation:
    @property
    def proto(self) -> validate_pb2.Violation: ...
    field_value: object
    rule_value: object
class ValidationError(ValueError):
    @property
    def violations(self) -> List[Violation]: ...
    def to_proto(self) -> validate_pb2.Violations: ...
class Validator:
    def __init__(self) -> None: ...
    def validate(self, message: Message, *, fail_fast: bool = False) -> None: ...
    def collect_violations(self, message: Message, *, fail_fast: bool = False) -> List[Violation]: ...
Violations = validate_pb2.Violations
